# === Обязательное ===
BOT_TOKEN=                     # токен от @BotFather
ADMIN_ID=                      # ваш числовой Telegram ID (узнать у @userinfobot)
PUBLIC_URL=                    # публичный URL после деплоя на Railway, напр. https://rospis-bot.up.railway.app

# === Premium-эмодзи вместо ✅ ===
# custom_emoji_id премиум-эмодзи. Как узнать id:
# 1) отправьте себе premium-эмодзи в Saved Messages
# 2) перешлите это сообщение боту @RawDataBot или @JsonDumpBot
# 3) в JSON найдите поле "custom_emoji_id" — вставьте его сюда
CHECK_EMOJI_ID=

# === Telegram Stars ===
# Для Stars отдельный токен не нужен — работает через сам BOT_TOKEN.

# === CryptoBot (@CryptoBot / @CryptoTestnetBot) ===
CRYPTOBOT_API_TOKEN=           # Crypto Pay API токен: @CryptoBot -> Crypto Pay -> Create App
CRYPTOBOT_API_URL=https://pay.crypt.bot/api

# === TON-кошелёк (приём напрямую в GRAM/TON) ===
TON_WALLET_ADDRESS=            # ваш TON-адрес для приёма оплаты
TONCENTER_API_KEY=             # (опционально) для автопроверки входящих платежей через toncenter.com

# === Прочее ===
PORT=3000
